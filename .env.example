# Keep the old database name in MONGODB_URI if it already exists.
# The application code forces all normal reads/writes to TELEIR_DB_NAME.
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:20827/teleir?authSource=admin
TELEIR_DB_NAME=teleirv2
TELEIR_LEGACY_DB_NAME=teleir

NEXTAUTH_URL=http://127.0.0.1:3012
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Phone-based admin bootstrap
ADMIN_PHONE=09123456789
